Backport Bun 1.3.14's BUN_ZIG_PATH support to 1.3.13.  This lets an
offline build use a compiler and standard library built from the pinned
oven-sh/zig source rather than downloading a release binary.

Reference:
https://github.com/oven-sh/bun/blob/bun-v1.3.14/scripts/build/zig.ts

diff --git a/scripts/build/zig.ts b/scripts/build/zig.ts
index cc38679..00cea1b 100644
--- a/scripts/build/zig.ts
+++ b/scripts/build/zig.ts
@@ -17,8 +17,8 @@
 
 import { existsSync, readFileSync, symlinkSync } from "node:fs";
 import { mkdir, readdir, rename, rm, writeFile } from "node:fs/promises";
-import { availableParallelism } from "node:os";
-import { resolve } from "node:path";
+import { availableParallelism, homedir } from "node:os";
+import { join, resolve } from "node:path";
 import type { Config, OS } from "./config.ts";
 import { downloadWithRetry, extractZip } from "./download.ts";
 import { assert } from "./error.ts";
@@ -164,7 +164,12 @@ export function codegenEmbed(cfg: Config): boolean {
  * commit pin is global and changing it affects everything.
  */
 function zigPath(cfg: Config): string {
-  return resolve(cfg.vendorDir, "zig");
+  const env = process.env.BUN_ZIG_PATH;
+  if (!env) return resolve(cfg.vendorDir, "zig");
+  if (env === "~" || env.startsWith("~/") || env.startsWith("~\\")) {
+    return join(homedir(), env.slice(1));
+  }
+  return resolve(cfg.cwd, env);
 }
 
 function zigExecutable(cfg: Config): string {
