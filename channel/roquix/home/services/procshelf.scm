(define-module (roquix home services procshelf)
  #:use-module (gnu home services)
  #:use-module (gnu home services shepherd)
  #:use-module (gnu services)
  #:use-module (gnu services configuration)
  #:use-module (guix gexp)
  #:use-module (guix packages)
  #:use-module (roquix packages procshelf)
  #:use-module (srfi srfi-13)
  #:export (home-procshelf-configuration
            home-procshelf-configuration?
            home-procshelf-configuration-procshelf
            home-procshelf-configuration-config-file
            home-procshelf-configuration-log-file
            home-procshelf-configuration-stop-timeout
            home-procshelf-shepherd-service
            home-procshelf-service-type))

(define (absolute-path? value)
  (and (string? value)
       (string-prefix? "/" value)
       (not (string-index value #\nul))))

(define (optional-absolute-path? value)
  (or (not value) (absolute-path? value)))

(define (writable-config-path? value)
  (and (optional-absolute-path? value)
       (or (not value)
           (not (or (string=? value "/gnu/store")
                    (string-prefix? "/gnu/store/" value))))))

(define (positive-integer? value)
  (and (exact-integer? value) (positive? value)))

(define-configuration/no-serialization home-procshelf-configuration
  (procshelf
   (package procshelf)
   "The package providing the procshelf server.")
  (config-file
   (writable-config-path #f)
   "An existing absolute TOML filename in a writable directory, or #f for
$XDG_CONFIG_HOME/procshelf/config.toml, falling back to ~/.config/procshelf/config.toml.
The default file is initialized once.  Procshelf writes its access key and lock
beside the canonical configuration path, so file-like objects and store paths
cannot be used.")
  (log-file
   (optional-absolute-path #f)
   "An absolute log filename whose parent exists, or #f for procshelf.log in
the Shepherd log directory.")
  (stop-timeout
   (positive-integer 30)
   "Seconds Shepherd allows for graceful shutdown before SIGKILL.  Set this
above the largest stop_timeout_seconds in the TOML configuration, with time
for child-process reaping.  The default allows for procshelf's ten-second
process stop timeout."))

(define (home-procshelf-config-file config)
  (or (home-procshelf-configuration-config-file config)
      #~(let ((xdg (getenv "XDG_CONFIG_HOME")))
          (string-append
           (if (and xdg (string-prefix? "/" xdg))
               xdg
               (string-append (getenv "HOME") "/.config"))
           "/procshelf/config.toml"))))

(define (home-procshelf-shepherd-service config)
  (list
   (shepherd-service
    (documentation "Run the procshelf process manager.")
    (provision '(procshelf))
    (modules '((shepherd support) (srfi srfi-13)))
    (start
     #~(make-forkexec-constructor
        (list #$(file-append (home-procshelf-configuration-procshelf config)
                            "/bin/procshelf")
              "--config"
              #$(home-procshelf-config-file config))
        #:directory (getenv "HOME")
        #:log-file #$(or (home-procshelf-configuration-log-file config)
                         #~(string-append %user-log-dir "/procshelf.log"))))
    (stop #~(make-kill-destructor
             #:grace-period #$(home-procshelf-configuration-stop-timeout config))))))

(define (home-procshelf-activation config)
  (with-imported-modules '((guix build utils))
    #~(begin
        (use-modules (guix build utils))
        #$(if (home-procshelf-configuration-config-file config)
              #~#t
              #~(let ((file #$(home-procshelf-config-file config)))
                  (mkdir-p (dirname file))
                  ;; Preserve user edits and the daemon's adjacent private key.
                  (unless (file-exists? file)
                    (let ((port (open file (logior O_WRONLY O_CREAT O_EXCL) #o600)))
                      (display "[web]\nlisten = \"127.0.0.1:8787\"\n" port)
                      (close-port port))))))))

(define home-procshelf-service-type
  (service-type
   (name 'home-procshelf)
   (description
    "Run procshelf as a user Shepherd service with a writable TOML configuration.
The initial configuration listens on localhost:8787 and manages no commands.
Edit the configuration to register processes; changes are reloaded automatically.
The access key is generated by procshelf beside the configuration file.")
   (extensions
    (list (service-extension home-activation-service-type
                             home-procshelf-activation)
          (service-extension home-shepherd-service-type
                             home-procshelf-shepherd-service)
          (service-extension home-profile-service-type
                             (lambda (config)
                               (list (home-procshelf-configuration-procshelf config))))))
   (default-value (home-procshelf-configuration))))
