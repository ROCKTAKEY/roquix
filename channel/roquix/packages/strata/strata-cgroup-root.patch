+++ b/tests/core/cgroup_path_test.cpp
@@ -0,0 +1,16 @@
+#include "strata/core/cgroup_path.hpp"
+
+#include <iostream>
+
+int main() {
+    const std::filesystem::path root("/sys/fs/cgroup");
+    if (strata::core::detail::cgroup_memory_path(root, "") != root) {
+        std::cerr << "The root cgroup must retain its identity for the host memory-limit exception\n";
+        return 1;
+    }
+    if (strata::core::detail::cgroup_memory_path(root, "user.slice/session.scope") !=
+        root / "user.slice/session.scope") {
+        std::cerr << "Child cgroups must keep their path for ancestor memory-limit checks\n";
+        return 1;
+    }
+}
