+++ b/serve/test_server.py
@@ -1790,6 +1790,16 @@
                 (hw / "power1_input").write_text("120000000\n")
             (hw / "power1_cap").write_text("300000000\n")
 
+    def test_missing_disk_counters(self):
+        from serve import telemetry
+        with tempfile.TemporaryDirectory() as directory, \
+                mock.patch.object(telemetry, "SYSFS", directory), \
+                mock.patch.object(telemetry.threading, "Thread"), \
+                mock.patch("psutil.disk_io_counters", return_value=None):
+            sample = telemetry.Telemetry(amd=True).sample()
+        self.assertIsNone(sample["disk_read_mb"])
+        self.assertIsNone(sample["disk_write_mb"])
+
