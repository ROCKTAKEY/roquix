+@dataclass(frozen=True)
+class SetupRequest:
+    arguments: tuple[str, ...]
+
+    @classmethod
+    def parse(cls, arguments: list[str]) -> "SetupRequest":
+        parser = argparse.ArgumentParser(prog="strata-setup", add_help=False)
+        parser.add_argument("--backend", choices=["hip"])
+        parser.add_argument("--vision", choices=["none", "no"])
+        parser.add_argument("--build", action="store_true")
+        parser.add_argument("--prebuilt")
+        options, _ = parser.parse_known_args(arguments)
+        if options.build or options.prebuilt is not None:
+            parser.error("Guix manages the engine; use guix upgrade strata-hip")
+        return cls(("--vision", "none", *arguments))
+
+
+@dataclass(frozen=True)
+class PackagedStrata:
+    root: Path
+    architectures: tuple[str, ...]
+    library_directories: tuple[str, ...]
+
+    @classmethod
+    def load(cls, root: Path) -> "PackagedStrata":
+        root = root.resolve()
+        metadata = json.loads((root / "engine/BUILD.json").read_text())
+        if not isinstance(metadata, dict) or metadata.get("backend") != "hip":
+            raise ValueError("the Guix package must provide a HIP engine")
+        if not (root / "engine/strata").is_file():
+            raise ValueError("the packaged Strata engine is missing")
+        return cls(
+            root,
+            cls._metadata_strings(metadata, "archs"),
+            cls._metadata_strings(metadata, "lib_dirs"),
+        )
+
+    @staticmethod
+    def _metadata_strings(metadata: dict[str, Any], key: str) -> tuple[str, ...]:
+        values = metadata.get(key)
+        if not isinstance(values, list) or not values or any(
+            not isinstance(value, str) or not value for value in values
+        ):
+            raise ValueError(f"invalid packaged {key}: expected nonempty strings")
+        return tuple(values)
+
+    def engine_for(self, gpu: dict[str, Any], vision: str) -> Path:
+        for architecture in gpu.get("archs") or [gpu["arch"]]:
+            if architecture not in self.architectures:
+                raise ValueError(f"the packaged engine does not support {architecture}")
+        if vision != "none" and not (self.root / "engine/strata-vision").is_file():
+            raise ValueError(
+                "this package does not include the optional vision encoder"
+            )
+        return self.root / "engine"
+
+    def prepare(self, state: Path) -> "PreparedStrata":
+        state = state.expanduser().resolve()
+        if state == self.root or state.is_relative_to(self.root):
+            raise ValueError("Strata state must be outside the package directory")
+        resources = (
+            "tools",
+            "serve",
+            "strata_control",
+            "data",
+            "engine",
+            "third_party",
+            "CMakeLists.txt",
+            "requirements.txt",
+        )
+        # Upstream resolves tools relative to ROOT and writes configurations there.
+        # https://github.com/Niko1221/Strata/blob/v0.1.34/setup.py
+        for name in resources:
+            target = state / name
+            if target.exists() and not target.is_symlink():
+                raise ValueError(f"refusing to replace user file: {target}")
+        state.mkdir(parents=True, exist_ok=True)
+        for name in resources:
+            target = state / name
+            if target.is_symlink():
+                target.unlink()
+            target.symlink_to(self.root / name)
+        return PreparedStrata(self, state)
+
+
+@dataclass(frozen=True)
+class PreparedStrata:
+    package: PackagedStrata
+    state: Path
+
+    def engine_for(self, gpu: dict[str, Any], vision: str) -> Path:
+        self.package.engine_for(gpu, vision)
+        return self.state / "engine"
+
+    def refresh_engine_configurations(self) -> None:
+        for path in installed_configs():
+            config = json.loads(path.read_text(encoding="utf-8-sig"))
+            config["exe"] = str(self.state / "engine/strata")
+            config["lib_dirs"] = list(self.package.library_directories)
+            write_config(path, config)
+
+
+def prepare_guix_setup(arguments: list[str]) -> list[str]:
+    global ROOT
+    request = SetupRequest.parse(arguments)
+    data_home = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
+    state = Path(os.environ.get("STRATA_STATE_DIR", data_home / "strata"))
+    prepared = PackagedStrata.load(PACKAGE_ROOT).prepare(state)
+    ROOT = prepared.state
+    data_directory = load_settings().get("data_dir", str(ROOT / "models-data"))
+    return ["--backend", "hip", "--data-dir", data_directory, *request.arguments]
 
 
