--- /dev/null
+++ b/include/strata/core/cgroup_path.hpp
@@ -0,0 +1,13 @@
+#pragma once
+
+#include <filesystem>
+#include <string>
+
+namespace strata::core::detail {
+inline std::filesystem::path cgroup_memory_path(const std::filesystem::path& root,
+                                               const std::string& relative) {
+    // Appending an empty path adds a trailing component, making it unequal to root.
+    // The host root has no memory.max and must reach the root-only exception.
+    return relative.empty() ? root : (root / relative).lexically_normal();
+}
+}
