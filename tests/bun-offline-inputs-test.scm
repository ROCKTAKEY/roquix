(use-modules (ice-9 textual-ports)
             (srfi srfi-1)
             (srfi srfi-13)
             (srfi srfi-64))

(define repository-root
  (dirname (dirname (canonicalize-path (current-filename)))))

(define (repository-file relative)
  (string-append repository-root "/" relative))

(define (read-repository-file relative)
  (call-with-input-file (repository-file relative)
    get-string-all))

(define forbidden-network-fetch-forms
  '("(define* (bun-webkit-fetch" "(define* (bun-npm-fetch"
    "(define* (bun-node-modules-fetch"
    "(method bun-webkit-fetch)"
    "(method bun-npm-fetch)"
    "(method bun-node-modules-fetch)"
    "cargo-inputs-from-lockfile"
    "cargo-lock-string->scm"
    "lol-html-cargo-lock"
    "#:leaked-env-vars"
    "nss-certs-for-test"
    "SSL_CERT_FILE"))

(define bun-cargo-input-keys
  '("bun-lol-html-1.0"
    "bun-lol-html-1.2.0"
    "bun-lol-html-1.2.17"
    "bun-lol-html-1.3.1"
    "bun-lol-html-1.3.13"))

(test-begin "bun-offline-inputs")

(for-each (lambda (relative)
            (let ((source (read-repository-file relative)))
              (for-each (lambda (form)
                          (test-assert (string-append relative " excludes "
                                                      form)
                                       (not (string-contains source form))))
                        forbidden-network-fetch-forms)))
          '("channel/roquix/packages/bun-bootstrap.scm"
            "channel/roquix/build-system/bun.scm"
            "channel/roquix/packages/opencode.scm"))

(let ((script (read-repository-file "scripts/update-bun-crates.sh")))
  (test-assert "Bun crate inputs are generated by Guix's crate importer"
               (and (string-contains script "guix import")
                    (string-contains script "--insert=")
                    (string-contains script "--lockfile=")))
  (test-assert "Bun crate importer reads the fixed lol-html origins"
               (and (string-contains script "guix build")
                    (string-contains script "c-api/Cargo.lock")
                    (string-contains script "cargo metadata")
                    (not (string-contains script
                                          "packages/aux-files/bun")))))

(for-each
 (lambda (name)
   (test-assert (string-append name " auxiliary lock is absent")
                (not (file-exists?
                      (repository-file
                       (string-append
                        "channel/roquix/packages/aux-files/bun/" name))))))
 '("lol-html-1.0.lock"
   "lol-html-1.2.0.lock"
   "lol-html-1.2.17.lock"
   "lol-html-1.3.1.lock"
   "lol-html-1.3.13.lock"))

(let ((crates (read-repository-file
               "channel/roquix/packages/rust-crates.scm")))
  (for-each (lambda (key)
              (test-assert (string-append key " has generated cargo inputs")
                           (string-contains crates
                                            (string-append "(" key " =>"))))
            bun-cargo-input-keys))

(let ((runner (test-runner-current)))
  (test-end "bun-offline-inputs")
  (exit (if (zero? (test-runner-fail-count runner)) 0 1)))
