@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+use std::path::Path;
+use std::process::Command;
+
+pub fn command(editor: &str, path: &Path) -> Command {
+    let mut command = Command::new("sh");
+    // Editor settings are user-supplied shell commands, but filenames can come
+    // from TMPDIR or the profile root. Passing the path as a positional argument
+    // preserves its bytes and prevents shell expansion of filename contents.
+    // https://pubs.opengroup.org/onlinepubs/9799919799/utilities/sh.html
+    command
+        .arg("-c")
+        .arg(format!("{} \"$1\"", editor))
+        .arg("cfait-editor")
+        .arg(path);
+    command
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn filename_is_literal_with_shell_metacharacters() {
+        let path = Path::new("/tmp/$(printf injected)`printf injected`/\"quoted\" '$HOME'\n文.md");
+        let output = command("printf '%s'", path).output().unwrap();
+        assert!(output.status.success());
+        assert_eq!(output.stdout, path.as_os_str().as_encoded_bytes());
+    }
+
+    #[test]
+    fn editor_options_are_preserved() {
+        let output = command("printf 'editor option: %s'", Path::new("file name.md"))
+            .output()
+            .unwrap();
+        assert!(output.status.success());
+        assert_eq!(output.stdout, b"editor option: file name.md");
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn non_utf8_filename_is_preserved() {
+        use std::ffi::OsStr;
+        use std::os::unix::ffi::OsStrExt;
+        let path = Path::new(OsStr::from_bytes(b"/tmp/\xff.md"));
+        let output = command("printf '%s'", path).output().unwrap();
+        assert!(output.status.success());
+        assert_eq!(output.stdout, path.as_os_str().as_encoded_bytes());
+    }
+}
